diff --git a/blakserv/main.c b/blakserv/main.c
index 969dbf0..2ca941b 100644
--- a/blakserv/main.c
+++ b/blakserv/main.c
@@ -67,6 +67,20 @@ void MainServer()
 	
 	InitConfig();
 	LoadConfig();		/* must be nearly first since channels use it */
+
+	/* DETERMINISTIC SEED, LAB ONLY.  The stock server never calls srand(), so C_Random's
+	   rand() stream is the same sequence on every boot -- there is exactly one "reality".
+	   Seeding here, immediately after config and before anything else can draw, makes that
+	   reality selectable, so one scenario can be run across many of them.
+
+	   NOTHING IS LOGGED HERE.  lprintf writes through the channel buffer and
+	   OpenDefaultChannels() has not run yet; calling it at this point segfaults the server
+	   before it can say why.  The announcement is further down, after the channels exist.
+
+	   OFF BY DEFAULT AND A NO-OP WHEN OFF.  An unseeded server keeps the stock behaviour
+	   exactly, so a harness that knows nothing about this patch sees no difference at all. */
+	if (ConfigBool(SIMSEED_ENABLED) && ConfigInt(SIMSEED_VALUE) != 0)
+		srand((unsigned int)ConfigInt(SIMSEED_VALUE));
 	
 	InitDebug();
 	
@@ -75,6 +89,13 @@ void MainServer()
 	OpenDefaultChannels();
 	
 	lprintf("Starting %s\n",BlakServLongVersionString());
+
+	/* Announced here rather than at the seed site: see the comment above.  This is the first
+	   point in main() where the stock server itself logs, so it is the first point logging is
+	   known to work. */
+	if (ConfigBool(SIMSEED_ENABLED) && ConfigInt(SIMSEED_VALUE) != 0)
+		lprintf("SimSeed: seeded rand() with %i (lab determinism)\n",
+			ConfigInt(SIMSEED_VALUE));
 	
 	InitClass();
 	InitMessage();
