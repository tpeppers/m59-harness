+/* Reports the reality this boot is running in, so a harness can ask rather than assume.
+   An UNPATCHED server does not know this command and answers with its ordinary
+   unknown-command error -- which is the whole graceful-degradation story: the caller learns
+   "unseeded" from the refusal and carries on, instead of requiring the patch to exist. */
+void AdminShowSimSeed(int session_id,admin_parm_type parms[],
+                      int num_blak_parm,parm_node blak_parm[])
+{
+	aprintf("SimSeed -----------------------------------\n");
+	if (ConfigBool(SIMSEED_ENABLED) && ConfigInt(SIMSEED_VALUE) != 0)
+		aprintf("seeded %i\n",ConfigInt(SIMSEED_VALUE));
+	else
+		aprintf("seeded 0 (unseeded: the stock rand() stream, identical every boot)\n");
+}
