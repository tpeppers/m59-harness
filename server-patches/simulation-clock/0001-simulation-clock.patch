+static bool SimulationGuardValid()
+{
+   char value[128];
+   const char *expected = M59_SIMULATION_GUARD_TEXT;
+   const char *filename = ConfigStr(SIMULATION_GUARD_FILE);
+   if (filename == NULL || strcmp(filename,M59_SIMULATION_GUARD_PATH) != 0)
+      return false;
+
+#ifdef BLAK_PLATFORM_LINUX
+   int descriptor = open(filename,O_RDONLY | O_NOFOLLOW);
+   if (descriptor < 0)
+      return false;
+   struct stat info;
+   if (fstat(descriptor,&info) != 0 || !S_ISREG(info.st_mode) ||
+       info.st_size != (off_t)strlen(expected))
+   {
+      close(descriptor);
+      return false;
+   }
+   FILE *guard = fdopen(descriptor,"rb");
+   if (guard == NULL)
+   {
+      close(descriptor);
+      return false;
+   }
+#else
+   FILE *guard = fopen(filename,"rb");
+   if (guard == NULL)
+      return false;
+#endif
+
+   size_t length = fread(value,1,sizeof(value),guard);
+   bool ok = !ferror(guard);
+   fclose(guard);
+   return ok && length == strlen(expected) &&
+          memcmp(value,expected,length) == 0;
+}
+
