+UINT64 GetMonotonicMilliCount()
+{
+#ifdef BLAK_PLATFORM_WINDOWS
+   return GetMilliCount();
+#else
+   struct timespec now;
+   if (clock_gettime(CLOCK_MONOTONIC,&now) != 0)
+   {
+      FatalError("Simulation clock cannot read CLOCK_MONOTONIC");
+      return 0;
+   }
+   return ((UINT64)now.tv_sec) * 1000 + ((UINT64)now.tv_nsec) / 1000000;
+#endif
+}
+
+bool SimulationClockEnabled()
+{
+   return simulation_enabled;
+}
+
+bool SimulationClockPaused()
+{
+   return simulation_enabled && simulation_paused;
+}
+
+int GetSimulationScale()
+{
+   return simulation_enabled ? simulation_scale : 1;
+}
+
+UINT64 GetSimulationMilliCount()
+{
+   if (!simulation_enabled)
+      return GetMilliCount();
+   if (simulation_paused)
+      return simulation_anchor;
+
+   UINT64 now = GetMonotonicMilliCount();
+   return simulation_anchor + (now - monotonic_anchor) * (UINT64)simulation_scale;
+}
+
+time_t GetSimulationTime()
+{
+   if (!simulation_enabled)
+      return GetTime();
+   return (time_t)(GetSimulationMilliCount()/1000);
+}
+
+INT64 GetSimulationWallWait(UINT64 simulation_deadline)
+{
+   UINT64 now = GetSimulationMilliCount();
+   if (simulation_deadline <= now)
+      return 0;
+
+   UINT64 remaining = simulation_deadline - now;
+   UINT64 scale = (UINT64)GetSimulationScale();
+   UINT64 wait = (remaining + scale - 1) / scale;
+   if (wait > (UINT64)INT64_MAX)
+      return INT64_MAX;
+   return (INT64)wait;
+}
+
+void PauseSimulationClock()
+{
+   if (!simulation_enabled || simulation_paused)
+      return;
+   simulation_anchor = GetSimulationMilliCount();
+   monotonic_anchor = GetMonotonicMilliCount();
+   simulation_paused = true;
+}
+
+void UnpauseSimulationClock()
+{
+   if (!simulation_enabled || !simulation_paused)
+      return;
+   monotonic_anchor = GetMonotonicMilliCount();
+   simulation_paused = false;
+}
+
+bool RestoreSimulationClock(UINT64 simulation_time)
+{
+   if (!simulation_enabled || !simulation_paused)
+      return false;
+   simulation_anchor = simulation_time;
+   monotonic_anchor = GetMonotonicMilliCount();
+   return true;
+}
