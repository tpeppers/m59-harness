+      return;
+   }
+
+   if (simulation_scale < 1 || simulation_scale > 100)
+      FatalError("Simulation Scale must be an integer from 1 through 100");
+   if (!SimulationGuardValid())
+      FatalError("Simulation Enabled requires the exact lab simulation guard file");
+
+   monotonic_anchor = GetMonotonicMilliCount();
+   simulation_anchor = ((UINT64)GetTime()) * 1000;
+
+   lprintf("Lab simulation clock enabled at %ix (%s)\n",
+           simulation_scale,M59_SIMULATION_CLOCK_SCHEMA);
 }
 
