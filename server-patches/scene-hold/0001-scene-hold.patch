 messages:
 
+   ScenePauseTimer(timer = $)
+   {
+      local left;
+      if timer = $ { return -1; }
+      left = Bound(GetTimeRemaining(timer),1,200000000);
+      DeleteTimer(timer);
+      return left;
+   }
+
+   SceneHold()
+   {
+      local entry, left;
+      if pbSceneHeld { return TRUE; }
+      pbSceneHeld = TRUE;
+      piSceneBehaviorMs = Send(self,@ScenePauseTimer,#timer=ptBehavior); ptBehavior = $;
+      piSceneRandomMs = Send(self,@ScenePauseTimer,#timer=ptRandom); ptRandom = $;
+      piSceneSpasmMs = Send(self,@ScenePauseTimer,#timer=ptSpasm); ptSpasm = $;
+      piSceneOfferMs = Send(self,@ScenePauseTimer,#timer=ptCancelOffer); ptCancelOffer = $;
+      piSceneUnturnMs = Send(self,@ScenePauseTimer,#timer=ptUnturn); ptUnturn = $;
+      plSceneEnchantments = $;
+      for entry in plEnchantments
+      {
+         left = Send(self,@ScenePauseTimer,#timer=First(entry));
+         if left >= 0
+         {
+            plSceneEnchantments = Cons([entry,left],plSceneEnchantments);
+            SetNth(entry,1,$);
+         }
+      }
+      return TRUE;
+   }
+
+   SceneRelease(fresh = FALSE)
+   {
+      local entry, message;
+      if NOT pbSceneHeld { return FALSE; }
+      pbSceneHeld = FALSE;
+      if piSceneBehaviorMs >= 0
+      {
+         message = @WaitTimer;
+         if piState & STATE_ATTACK { message = @AttackTimer; }
+         if piState & STATE_CHASE { message = @ChaseTimer; }
+         if piState & STATE_MOVE { message = @MoveTimer; }
+         ptBehavior = CreateTimer(self,message,piSceneBehaviorMs);
+      }
+      else { if fresh { Send(self,@EnterStateWait,#delay=1); } }
+      if piSceneRandomMs >= 0 { ptRandom = CreateTimer(self,@RandomTimer,piSceneRandomMs); }
+      if piSceneSpasmMs >= 0 { ptSpasm = CreateTimer(self,@SpasmMonsterTimer,piSceneSpasmMs); }
+      if piSceneOfferMs >= 0 { ptCancelOffer = CreateTimer(self,@CancelOfferTimer,piSceneOfferMs); }
+      if piSceneUnturnMs >= 0 { ptUnturn = CreateTimer(self,@UnTurn,piSceneUnturnMs); }
+      for entry in plSceneEnchantments
+      {
+         SetNth(First(entry),1,CreateTimer(self,@EnchantmentTimer,Nth(entry,2)));
+      }
+      plSceneEnchantments = $;
+      return TRUE;
+   }
+
